# Directus base URL, without /graphql or /assets.
GRAPHQL_ENDPOINT=https://directus-production-2664.up.railway.app
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://directus-production-2664.up.railway.app
NEXT_PUBLIC_DIRECTUS_ASSETS=https://directus-production-2664.up.railway.app
NEXT_PUBLIC_SITE_URL=https://www.findasaint.com

# Images straight from Cloudflare (optional). The custom domain attached
# to the R2 bucket that Directus stores files in, with Image
# Transformations enabled on its zone. When set, the site builds
# https://<host>/cdn-cgi/image/<options>/<filename_disk> and Directus is
# only used for uploads. Leave empty to serve images through Directus.
NEXT_PUBLIC_IMAGE_HOST=
# Only if Directus has a STORAGE_<LOCATION>_ROOT prefix in the bucket.
NEXT_PUBLIC_IMAGE_ROOT=
