 "share_kit": {
  "tagline": "She told the voice she knew nothing of riding or fighting. It sent her anyway.",
  "did_you_know": [
   {
    "fact": "As a girl in Domrémy, Joan was teased by her neighbors for going to church too often.",
    "card": "notes-witnesses §3 (Hauviette, Quicherat II p. 418; Waterin, II p. 420)"
   },
   {
    "fact": "She carried her banner into battle instead of her sword, and told her judges she had never killed anyone.",
    "card": "notes-own-words §4–5 (Murray p. 31)"
   },
   {
    "fact": "At Jargeau she told the duke of Alençon to move from where he stood, and soon afterward another lord was killed on that very spot.",
    "card": "notes-witnesses §3 (d’Alençon, Quicherat III pp. 96–97)"
   },
   {
    "fact": "When the women of Bourges brought rosaries for her to touch, she laughed and told them their own touch would do as well.",
    "card": "notes-witnesses §3, §5 no. 13 (Touroulde, Quicherat III p. 87)"
   },
   {
    "fact": "A jar of supposed relics of Joan, found in a Paris pharmacy in 1867, turned out in 2007 to hold Egyptian mummy remains and a cat’s thigh bone.",
    "card": "notes-church-miracles §7 C32–34"
   }
  ],
  "quote_cards": [
   {
    "text": "Answer boldly; God will help thee.",
    "attribution": "Words of her Voice, as Joan of Arc told her judges, Rouen, 24 February 1431 (Murray’s translation)"
