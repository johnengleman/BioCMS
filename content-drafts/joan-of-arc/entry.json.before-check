 "identity": {
  "requested_name": "Joan of Arc (Jeanne d'Arc)",
  "resolved_name": "Joan of Arc (Jeanne d’Arc), called the Maid (la Pucelle)",
  "aliases": [
   "Jeanne d’Arc",
   "Jeannette (family name for her at Domrémy)",
