   {
    "text": "If I am not, may God place me there; if I am, may God so keep me.",
    "attribution": "Joan of Arc, asked whether she was in the grace of God, Rouen, 1431 (Murray’s translation)"
   },
   {
    "text": "Better, forty times better, my banner than my sword!",
    "attribution": "Joan of Arc to her judges, Rouen, 1431 (Murray’s translation)"
   }
  ],
  "share_moments": [
   {
    "moment": "The vineyard and the banner: a quarter of an hour of prayer, then “Ah, my banner! my banner!”",
