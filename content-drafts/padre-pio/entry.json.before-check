  "share_kit": {
    "tagline": "He asked to suffer in hiding. For fifty years the world watched his hands.",
    "did_you_know": [
      {
        "fact": "Asked how his humility survived the crowds, he said a man who claimed God’s gifts as his own would be either mad or a thief.",
        "card": "notes-witnesses §4 (McCaffery 1978, pp. 62–63)"
      },
      {
        "fact": "When the Holy Office ordered him moved to Ancona in 1923, the townspeople of San Giovanni Rotondo protested until the transfer was put off.",
        "card": "notes-witnesses §3 (Voce di Padre Pio chronology)"
      },
      {
        "fact": "A bishop sent secretly by the Holy Office in 1921 smelled violets in his cell, looked for the source, and found only ordinary soap.",
        "card": "notes-witnesses §3; notes-church-miracles §7D (Castelli via caccioppoli.com; en.wikipedia)"
      },
      {
        "fact": "In 1957 Pope Pius XII released him from his vow of poverty so that he could oversee the hospital he had founded.",
        "card": "notes-witnesses §3 (en.wikipedia)"
      },
      {
        "fact": "The night before he died, long after midnight, he asked the friar sitting with him, “Have you said Mass yet?”",
        "card": "notes-witnesses §3 (McCaffery 1978, pp. 125–126)"
      }
