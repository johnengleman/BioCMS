    "death_year": 1968,
    "birth_location": "Pietrelcina, province of Benevento, Kingdom of Italy",
    "death_location": "Capuchin friary of Our Lady of Grace (Santa Maria delle Grazie), San Giovanni Rotondo, Italy",
    "feast_day_catholic": "2000-09-23",
